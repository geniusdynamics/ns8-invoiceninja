#
# nginx serves the public files and passes PHP requests to the PHP-FPM
# server of the application container, as in the upstream setup.
#
[Unit]
Description=Podman nginx-app.service
BindsTo=invoiceninja.service
After=invoiceninja.service invoiceninja-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
Restart=always
RestartSec=5
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/nginx-app.pid %t/nginx-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/nginx-app.pid \
    --cidfile %t/nginx-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/invoiceninja.pod-id --replace -d --name nginx-app \
    --volume invoiceninja-public:/var/www/app/public:ro,z \
    --volume %E/etc/nginx-invoiceninja.conf:/etc/nginx/conf.d/default.conf:ro,z \
    ${NGINX_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/nginx-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/nginx-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/nginx-app.pid
Type=forking

[Install]
WantedBy=default.target
